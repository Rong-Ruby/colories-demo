/* pages/record/record.wxss */
.container {
  padding-bottom: 64rpx;
}

/* 顶部摄入卡片 */
.goal-card {
  display: flex;
  flex-direction: column;
  padding: 40rpx 32rpx 32rpx;
  margin-bottom: 32rpx;
}

.goal-top {
  display: flex;
  align-items: flex-start;
}

.goal-item {
  flex: 1;
}

.goal-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.metric-label {
  font-size: 24rpx;
  color: #9CA3AF;
}

.metric-line {
  display: flex;
  align-items: baseline;
  margin-top: 12rpx;
}

.metric-value {
  font-size: 64rpx;
  font-weight: 700;
  color: #2563EB;
  line-height: 1.1;
}

.metric-unit {
  font-size: 22rpx;
  color: #6B7280;
  margin-left: 8rpx;
}

.goal-target {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.goal-value {
  font-size: 34rpx;
  font-weight: 600;
  color: #111827;
}

/* 三级操作：修改目标 */
.pill-btn {
  margin-left: 16rpx;
  padding: 0 24rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #2563EB;
  border-radius: 999rpx;
  color: #2563EB;
  font-size: 22rpx;
  font-weight: 500;
  box-sizing: border-box;
}

.pill-btn-hover {
  background: #EAF1FF;
}

/* 达标提示 */
.remaining-chip {
  align-self: flex-start;
  margin-top: 28rpx;
  padding: 10rpx 24rpx;
  background: #EAF1FF;
  color: #2563EB;
  font-size: 24rpx;
  border-radius: 999rpx;
}

.remaining-chip.over {
  background: #FDECEC;
  color: #DC2626;
}

/* 区块通用 */
.section {
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #F3F5F9;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.section-tip {
  font-size: 22rpx;
  color: #9CA3AF;
}

/* 今日记录列表 */
.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 2rpx solid #F5F7FA;
}

.list-item:last-child {
  border-bottom: none;
  padding-bottom: 8rpx;
}

.list-item-hover {
  background: #F6F8FB;
}

.list-left {
  display: flex;
  flex-direction: column;
}

.food-name {
  font-size: 28rpx;
  color: #111827;
}

.food-time {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 6rpx;
}

.food-calorie {
  font-size: 32rpx;
  font-weight: 600;
  color: #2563EB;
}

.food-unit {
  font-size: 20rpx;
  font-weight: 400;
  color: #6B7280;
}

.empty {
  text-align: center;
  color: #9CA3AF;
  font-size: 26rpx;
  padding: 40rpx 0;
}

/* 近 7 天汇总 */
.week-list {
  display: flex;
  flex-wrap: wrap;
}

.week-item {
  width: calc(50% - 8rpx);
  background: #F6F8FB;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  box-sizing: border-box;
}

.week-item:nth-child(odd) {
  margin-right: 16rpx;
}

.week-day {
  font-size: 24rpx;
  color: #6B7280;
}

.week-total {
  font-size: 32rpx;
  font-weight: 600;
  color: #2563EB;
}

.week-unit {
  font-size: 20rpx;
  font-weight: 400;
  color: #6B7280;
}

.week-avg {
  margin-top: 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: #6B7280;
}

/* 数据来源提示 */
.data-source {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9CA3AF;
}
