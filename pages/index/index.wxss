/* pages/index/index.wxss */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 标题区 */
.header {
  margin-top: 40rpx;
  margin-bottom: 60rpx;
  text-align: center;
}

.header-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 12rpx;
}

.header-sub {
  font-size: 26rpx;
  color: #888;
}

/* 扫描区域 */
.scan-area {
  width: 520rpx;
  height: 520rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  border: 2rpx dashed #4A90D9;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 60rpx;
  box-sizing: border-box;
}

.scan-icon {
  width: 160rpx;
  height: 160rpx;
  background: #EAF2FB;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.scan-emoji {
  font-size: 80rpx;
}

.scan-hint {
  font-size: 26rpx;
  color: #999;
}

.scan-hint.scanning {
  color: #4A90D9;
}

/* 识别按钮 */
.scan-btn {
  width: 520rpx;
  margin-bottom: 60rpx;
}

.scan-btn.disabled {
  background: #AAC6E6;
}

/* 今日摄入快览 */
.today-card {
  width: 520rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx;
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.today-label {
  font-size: 28rpx;
  color: #666;
}

.today-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #4A90D9;
}

.today-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: #4A90D9;
  margin-left: 4rpx;
}
