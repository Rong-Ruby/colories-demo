/* pages/index/index.wxss */
.container {
  display: flex;
  flex-direction: column;
}

/* 标题 */
.page-head {
  margin-bottom: 40rpx;
}

/* 取景卡片 */
.scan-card {
  padding: 32rpx;
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 40rpx;
}

.viewfinder {
  position: relative;
  height: 460rpx;
  background: #F3F6FB;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 取景框四角 */
.scan-corner {
  position: absolute;
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid #2563EB;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.corner-tl {
  top: 40rpx;
  left: 40rpx;
  border-right-color: transparent;
  border-bottom-color: transparent;
}

.corner-tr {
  top: 40rpx;
  right: 40rpx;
  border-left-color: transparent;
  border-bottom-color: transparent;
}

.corner-bl {
  bottom: 40rpx;
  left: 40rpx;
  border-right-color: transparent;
  border-top-color: transparent;
}

.corner-br {
  bottom: 40rpx;
  right: 40rpx;
  border-left-color: transparent;
  border-top-color: transparent;
}

.scan-body {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.scan-hint {
  font-size: 24rpx;
  color: #6B7280;
}

/* 识别中的旋转指示 */
.loading-ring {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid #DBE7FF;
  border-top-color: #2563EB;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.scan-foot {
  margin-top: 24rpx;
  text-align: center;
}

.scan-tip {
  font-size: 22rpx;
  color: #9CA3AF;
}

/* 一级主按钮 */
.scan-btn {
  width: 100%;
  margin-bottom: 40rpx;
}

.scan-btn.is-disabled {
  opacity: 0.5;
  box-shadow: none;
}

/* 今日摄入快览 */
.today-card {
  padding: 32rpx 40rpx;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.today-label {
  font-size: 26rpx;
  color: #6B7280;
}

.today-metric {
  display: flex;
  align-items: baseline;
}

.today-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #2563EB;
}

.today-unit {
  font-size: 22rpx;
  color: #6B7280;
  margin-left: 8rpx;
}
