<view class="container">
  <!-- 标题 -->
  <view class="header">
    <text class="header-title">识别卡路里</text>
    <text class="header-sub">拍一拍食物，快速知道它的热量</text>
  </view>

  <!-- 扫描区域 -->
  <view class="scan-area">
    <view class="scan-icon">
      <text class="scan-emoji">📷</text>
    </view>
    <view class="scan-hint" wx:if="{{!scanning}}">将食物对准识别框</view>
    <view class="scan-hint scanning" wx:if="{{scanning}}">识别中…</view>
  </view>

  <!-- 开始识别按钮 -->
  <view class="btn-primary scan-btn {{scanning ? 'disabled' : ''}}" bindtap="onStartScan">
    {{scanning ? '识别中…' : '开始识别'}}
  </view>

  <!-- 今日摄入快览 -->
  <view class="today-card">
    <text class="today-label">今日已记录</text>
    <text class="today-value">{{todayTotal}} <text class="today-unit">kcal</text></text>
  </view>

  <!-- 识别结果弹窗 -->
  <confirm-modal
    show="{{modalShow}}"
    foodName="{{modalFoodName}}"
    calorie="{{modalCalorie}}"
    bind:record="onConfirmRecord"
    bind:cancel="onConfirmCancel"
  />
</view>
