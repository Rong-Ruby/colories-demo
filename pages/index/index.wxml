<view class="container">
  <!-- 标题 -->
  <view class="page-head">
    <text class="page-title">识别卡路里</text>
    <text class="page-sub">拍一张照片，马上知道你吃了多少</text>
  </view>

  <!-- 取景卡片 -->
  <view class="card scan-card">
    <view class="viewfinder">
      <view class="scan-corner corner-tl"></view>
      <view class="scan-corner corner-tr"></view>
      <view class="scan-corner corner-bl"></view>
      <view class="scan-corner corner-br"></view>
      <view class="scan-body">
        <view class="loading-ring" wx:if="{{scanning}}"></view>
        <text class="scan-hint" wx:if="{{!scanning}}">点击下方按钮开始</text>
      </view>
    </view>
    <view class="scan-foot">
      <text class="scan-tip">支持拍照，或从相册选择 1 张照片</text>
    </view>
  </view>

  <!-- 一级操作：开始识别 -->
  <view
    class="btn-primary scan-btn {{scanning ? 'is-disabled' : ''}}"
    hover-class="{{scanning ? 'none' : 'btn-primary-hover'}}"
    bindtap="onStartScan"
  >
    {{scanning ? '识别中…' : '开始识别'}}
  </view>

  <!-- 今日摄入快览 -->
  <view class="card today-card">
    <text class="today-label">今日已记录</text>
    <view class="today-metric">
      <text class="today-value">{{todayTotal}}</text>
      <text class="today-unit">kcal</text>
    </view>
  </view>

  <!-- 识别结果弹窗 -->
  <confirm-modal
    show="{{modalShow}}"
    foodName="{{modalFoodName}}"
    calorie="{{modalCalorie}}"
    bind:record="onConfirmRecord"
    bind:cancel="onConfirmCancel"
  />
</view>
